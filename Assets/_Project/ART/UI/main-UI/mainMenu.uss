/* Oyun Başlığı Görünümü */
.title-label {
    font-size: 110px;
    color: rgb(240, 230, 255); /* Hafif morumsu beyaz, arka plana tatlı bir kontrast sağlar */
    -unity-font-style: bold;
    -unity-text-align: middle-center; /* Yazıyı tam ortalar */
    text-shadow: 4px 4px 0px rgba(120, 80, 200, 0.8); /* Buton renkleriyle uyumlu estetik bir gölge */
    letter-spacing: 10px; /* Harfler arası hafif boşluk (daha sinematik bir hava katar) */
}

/* Temel Buton Görünümü */
.button {
    width: 80%; /* Konteynerin %80'ini kaplar */
    padding: 15px; /* İç boşluk, butonları dolgun gösterir */
    margin: 8px; /* Butonlar arası mesafe */
    background-color: rgba(120, 80, 200, 0.3); /* Yarı saydam mor arka plan */
    color: rgb(255, 255, 255);
    font-size: 26px; /* Yazı boyutu */
    -unity-font-style: bold; /* Kalın yazı tipi */
    
    /* Çerçeve ayarları */
    border-color: rgb(180, 100, 255);
    border-width: 2px;
    border-radius: 12px; /* Köşeleri yuvarlatma */
    
    /* Animasyon (Transition) ayarları */
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-in-out-sine;
}

/* Fare ile Butonun Üzerine Gelindiğinde (Hover Efekti) */
.button:hover {
    scale: 1.05 1.05; /* Butonu %5 büyütür */
    background-color: rgba(180, 100, 255, 0.6); /* Arka planı belirginleştirir */
    border-color: rgb(255, 255, 255); /* Çerçeveyi beyaza parlatır */
}

/* Butona Tıklandığı Anda (Active/Click Animasyonu) */
.button:active {
    scale: 0.95 0.95; /* Butonu içeri doğru bastırır (küçültür) */
    background-color: rgba(180, 100, 255, 0.9); /* Arka planı iyice doldurur */
    border-color: rgb(200, 200, 200);
    color: rgb(220, 220, 220); /* Yazı rengini hafif karartır, basılma hissini artırır */
    
    /* Tıklama esnasında animasyonun anında tepki vermesi için süreyi kısaltıyoruz */
    transition-duration: 0.05s;
}

/* Ekran Kararma (Fade) Efekti İçin Katman */
.fade-overlay {
    position: absolute; /* Diğer her şeyin üzerine ve bağımsız yerleşmesi için */
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0; /* Başlangıçta tamamen saydam (görünmez) */
    transition-property: opacity;
    transition-duration: 1s; /* 1 saniyede yavaşça kararır */
}

.fade-overlay--active {
    opacity: 1; /* Kod ile bu class eklendiğinde ekran simsiyah olur */
}

/* YÜKLEME EKRANI TASARIMI */
.loading-screen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    justify-content: flex-end; /* Sadece barı alta hizalar */
    align-items: center;
    padding-bottom: 150px;
    opacity: 0; /* Başlangıçta tamamen saydam */
    picking-mode: ignore; /* Gizliyken tıklanmaları engellemez */
    transition: opacity 0.5s ease-in; /* Butonların kaybolma süresiyle aynı hızda belirir */
}

.loading-screen--visible {
    opacity: 1; /* Kod tetiklendiğinde bar yavaşça belirir */
}

.loading-bar-container {
    width: 60%; /* Barın uzunluğu */
    height: 18px; /* Barın kalınlığı */
    background-color: rgba(0, 0, 0, 0.5); /* Arka plan koyuluğu */
    border-radius: 9px;
    border-color: rgb(180, 100, 255);
    border-width: 2px;
    overflow: hidden; /* Taşan iç dolguyu gizler */
}

.loading-bar-fill {
    width: 0%; /* KOD İLE ARTACAK (%0'dan %100'e) */
    height: 100%;
    background-color: rgb(180, 100, 255);
}

/* Butonların bulunduğu ana konteyner */
.buttons-container {
    flex-grow: 1;
    width: 52%;
    min-height: 0%;
    max-height: 31%;
    align-items: center;
    justify-content: space-between;
    opacity: 1;
    transition: opacity 0.5s ease-in;
}

.buttons-container--hidden {
    opacity: 0;
    picking-mode: ignore; /* Gizlenirken tıklanmasını engeller */
}

/* --- YAPIMCILAR PANELİ TASARIMI VE ANİMASYONLARI --- */
.credits-panel {
    position: absolute;
    width: 40%;
    height: 60%;
    top: 20%; /* Dikey ortalama (100-60)/2 = 20% */
    left: 30%; /* Yatay ortalama (100-40)/2 = 30% */
    background-color: rgba(15, 15, 18, 0.98); /* Siyaha yakın, zarif bir arka plan */
    border-color: rgb(180, 180, 180); /* Açık gri bir çerçeve */
    border-width: 2px;
    border-radius: 15px;
    align-items: center;
    justify-content: space-around;
    padding: 25px;
    
    /* Tatlı bir açılış animasyonu için (Yaylanma ve Karararak Gelme) */
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back; 
}

.credits-panel--hidden {
    opacity: 0;
    scale: 0.8 0.8; /* Görünmezken hafif küçüktür */
    visibility: hidden; /* Tıklamaları engellemek için gizlenir */
}

.credits-title {
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    letter-spacing: 5px;
}

.credits-names-container {
    align-items: center;
    justify-content: center;
}

.credits-name {
    font-size: 26px;
    color: rgb(210, 210, 210); /* Mor değil, okunması kolay açık gri */
    margin: 6px 0;
    -unity-font-style: bold;
}

.credits-close-button {
    width: 60%;
    background-color: rgba(60, 60, 60, 0.8); /* Normal butonların aksine sade bir kapatma butonu */
    border-color: rgb(150, 150, 150);
}

/* --- AYARLAR PANELİ TASARIMI --- */
.settings-panel {
    position: absolute;
    width: 40%;
    height: 60%;
    top: 20%;
    left: 30%;
    background-color: rgba(15, 15, 18, 0.98); /* Yapımcılar ile aynı koyu ton */
    border-color: rgb(180, 180, 180);
    border-width: 2px;
    border-radius: 15px;
    align-items: center;
    justify-content: space-around;
    padding: 25px;
    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
}

.settings-panel--hidden {
    opacity: 0;
    scale: 0.8 0.8;
    visibility: hidden;
}

.settings-title {
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    letter-spacing: 5px;
}

.settings-content-container {
    width: 80%;
    justify-content: center;
}

.slider-container {
    margin: 15px 0;
}

.slider-label {
    font-size: 24px;
    color: rgb(210, 210, 210);
    -unity-font-style: bold;
    margin-bottom: 5px;
}

/* Custom Slider Ayarları - Unity'nin varsayılan tasarımını ezer */
.custom-slider #unity-tracker {
    background-color: rgb(40, 40, 45); /* Çubuğun arkası koyu gri */
    border-color: rgb(100, 100, 100);
    border-width: 1px;
    border-radius: 4px;
    height: 8px;
    margin-top: -4px; /* Dikey ortalama */
}

.custom-slider #unity-dragger {
    width: 24px;
    height: 24px;
    border-radius: 12px; /* Tam yuvarlak yapar */
    background-color: rgb(210, 210, 210);
    border-color: rgb(180, 100, 255); /* Oyuncuyu boğmayan, incecik tematik mor detay */
    border-width: 2px;
    margin-top: -12px; 
    transition: scale 0.1s ease-in-out, background-color 0.1s ease-in-out;
}

.custom-slider #unity-dragger:hover {
    background-color: rgb(255, 255, 255);
    scale: 1.15 1.15;
}

.settings-close-button {
    width: 60%;
    background-color: rgba(60, 60, 60, 0.8);
    border-color: rgb(150, 150, 150);
}